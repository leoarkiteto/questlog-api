# Questlog — copy this file to .env and fill in your values.
#   cp .env.example .env
# Secrets in .env are gitignored; existing shell env vars take
# precedence over this file.

# Neon Postgres connection string
# DATABASE_URL=postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/questlog?sslmode=require
# PORT=8080

# Session lifetime as a Go duration (default 30d). Sessions are opaque
# HttpOnly cookies backed by the Postgres `sessions` table.
# SESSION_MAX_AGE=720h

# Password pepper — REQUIRED. A server-side secret keyed into every
# password hash (HMAC-SHA256 before Argon2id); it is never stored in the
# database. The server and `cmd/user` must use the SAME value, and
# rotating it invalidates all passwords. Generate with:
#   openssl rand -hex 32
PASSWORD_PEPPER=

# Steam Web API key — kept server-side (optional for current features)
# STEAM_API_KEY=

# IGDB via a free Twitch developer app (dev.twitch.tv/console/apps).
# Required for covers of games that are not on Steam (PS5, Switch, …).
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
