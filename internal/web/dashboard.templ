package web

import (
	"fmt"
)

// DashboardPage renders the home page: featured hero + horizontal rows
// per status.
templ DashboardPage(v DashboardView) {
	if v.Featured != nil {
		<a href={ fmt.Sprintf("/games/%d", v.Featured.ID) } class="group relative mx-4 block overflow-hidden rounded-2xl ring-1 ring-white/10 sm:mx-6">
			@GameCover(v.Featured.Title, v.Featured.CoverURL, "h-60 w-full sm:h-80")
			<div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/40 to-transparent"></div>
			<div class="absolute inset-x-0 bottom-0 p-5 sm:p-8">
				<p class="mb-1 text-[11px] font-semibold uppercase tracking-[0.2em] text-red-400">
					Featured · { featuredLabel(v.Featured) }
				</p>
				<h1 class="text-3xl font-black tracking-tight text-white drop-shadow sm:text-5xl">{ v.Featured.Title }</h1>
				<div class="mt-2 flex flex-wrap items-center gap-3 text-sm text-zinc-300">
					if v.Featured.Rating > 0 {
						<span class="flex items-center gap-1.5 rounded-full bg-black/50 px-2.5 py-1 backdrop-blur">
							@StarRating(v.Featured.Rating, "sm")
						</span>
					}
					<span>{ featuredMeta(v.Featured) }</span>
				</div>
				<span class="mt-3 inline-block rounded-full bg-red-600 px-4 py-1.5 text-sm font-semibold text-white shadow-lg shadow-red-900/40 transition group-hover:bg-red-500">View →</span>
			</div>
		</a>
	} else {
		<div class="mx-4 rounded-2xl bg-gradient-to-r from-red-950/60 to-zinc-900 px-5 py-8 ring-1 ring-white/10 sm:mx-6 sm:px-8">
			<h1 class="text-2xl font-black text-white sm:text-3xl">Welcome to your Questlog</h1>
			<p class="mt-1 text-sm text-zinc-400">Track games you want to play, own, are playing, finished, or dropped.</p>
		</div>
	}

	<div class="mt-8 space-y-2">
		for i, row := range v.Rows {
			<section class={ dashboardRowClass(i) }>
				@GameRow(row.Status, row.Games, fmt.Sprintf("/library?filter=%s", row.Status))
			</section>
		}
	</div>
}
