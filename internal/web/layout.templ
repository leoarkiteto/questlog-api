package web

// Layout wraps every page: <html>, <head>, sticky Header, <main>,
// and the mobile-only BottomNav. `q` pre-fills the header search input.
templ Layout(title string, path string, q string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<title>{ title }</title>
			<link rel="icon" type="image/png" href="/static/questlog.png">
			<link rel="stylesheet" href="/static/css/styles.css">
			<script src="/static/js/htmx.min.js" defer></script>
			<script src="/static/js/app.js" defer></script>
		</head>
		<body hx-boost="true" class="min-h-dvh bg-zinc-950 font-sans text-zinc-100 antialiased">
			@Header(path, q)
			<main class="mx-auto max-w-6xl pt-4 pb-24 md:pb-12">
				@content
			</main>
			@BottomNav(path)
		</body>
	</html>
}

// Header is the sticky top bar: logo, search field, add button.
templ Header(path string, q string) {
	<header class="sticky top-0 z-40 border-b border-white/5 bg-zinc-950/85 backdrop-blur-md">
		<div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3 sm:px-6">
			<a href="/" class="flex shrink-0 items-center gap-2">
				<img src="/static/questlog.png" alt="Questlog" class="h-6 w-auto">
			</a>

			<form action="/search" method="get" class="ml-auto flex min-w-0 flex-1 justify-end sm:max-w-sm">
				<div class="relative w-full max-w-[10rem] transition-all focus-within:max-w-full sm:max-w-full">
					<svg viewBox="0 0 24 24" class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 fill-none stroke-zinc-500">
						<circle cx="11" cy="11" r="7" stroke-width="2"></circle>
						<path d="M20 20l-3.5-3.5" stroke-width="2" stroke-linecap="round"></path>
					</svg>
					<input type="search" name="q" value={ q } placeholder="Search your library…" aria-label="Search your library"
						class="w-full truncate rounded-full border-white/10 bg-zinc-900 py-2 pr-8 pl-9 text-sm text-zinc-100 placeholder-zinc-500 focus-visible:border-red-500/50 focus-visible:bg-zinc-900">
					if q != "" {
						<button type="button" aria-label="Clear search" onclick="this.previousElementSibling.value='';this.previousElementSibling.focus();this.classList.add('hidden')"
							class="absolute top-1/2 right-2 grid h-5 w-5 -translate-y-1/2 place-items-center rounded-full text-zinc-400 transition hover:bg-white/10 hover:text-zinc-100">
							@Icon("x", "h-3.5 w-3.5")
						</button>
					}
				</div>
			</form>

			<a href="/games/new" class="hidden h-9 w-9 shrink-0 place-items-center rounded-full bg-red-600 text-xl font-bold text-white shadow-lg shadow-red-900/40 transition hover:bg-red-500 md:grid">+</a>
		</div>
	</header>
}

// BottomNav is the mobile-only bottom navigation: Home · Add · Library.
templ BottomNav(path string) {
	<nav class="fixed inset-x-0 bottom-0 z-40 border-t border-white/5 bg-zinc-950/90 pb-[env(safe-area-inset-bottom)] backdrop-blur-md md:hidden">
		<div class="grid grid-cols-3 items-center">
			<a href="/" class="flex flex-col items-center gap-1 py-2.5 text-[11px] font-medium text-zinc-500 transition active:scale-95" aria-current={ ariaCurrent(path == "/") }>
				<svg viewBox="0 0 24 24" class={ navIconClass(path == "/") }>
					<path d="M3 10.5L12 3l9 7.5M5 9v11h14V9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
				Home
			</a>

			<a href="/games/new" aria-label="Add game" class="flex flex-col items-center gap-1 py-2.5 text-[11px] font-medium text-zinc-500">
				<span class="-mt-5 grid h-12 w-12 place-items-center rounded-full bg-gradient-to-b from-red-500 to-red-700 text-2xl font-bold text-white shadow-lg shadow-red-900/50 ring-4 ring-zinc-950 transition active:scale-95">+</span>
				Add
			</a>

			<a href="/library" class="flex flex-col items-center gap-1 py-2.5 text-[11px] font-medium text-zinc-500 transition active:scale-95" aria-current={ ariaCurrent(isLibrary(path)) }>
				<svg viewBox="0 0 24 24" class={ navIconClass(isLibrary(path)) }>
					<path d="M4 5h16M4 12h16M4 19h10" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
				Library
			</a>
		</div>
	</nav>
}
